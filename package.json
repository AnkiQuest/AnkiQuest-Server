{
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p web && tsc -p tests",
    "test:web": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test --test-concurrency=1 tests/*.test.ts",
    "screenshots:web": "node --experimental-strip-types --no-warnings=ExperimentalWarning tests/tools/web-screenshots.ts",
    "banner": "npm run screenshots:web && cargo run -p ankiquest-xtask -- banner"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
