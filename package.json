{
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p web && tsc -p tests",
    "test:web": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test --test-concurrency=1 tests/*.test.ts",
    "screenshots:web": "node --experimental-strip-types --no-warnings=ExperimentalWarning tests/tools/web-screenshots.ts",
    "screenshots": "npm run screenshots:web && cargo run -p ankiquest-xtask -- banner && cargo run -p ankiquest-xtask -- banner --social"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "dejavu-fonts-ttf": "2.37.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
