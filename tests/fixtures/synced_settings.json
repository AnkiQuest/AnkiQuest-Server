{
  "_about": "Player preferences that follow the account to every device through GET/PUT /api/settings/{user}. The server reads `keys` from this file (src/synced_settings.rs) and tests `server_merge`; both clients map their own preference names with `desktop` and `android` and test `client_merge`. A client applies only the keys it has; null means that client has no such setting. The server also keeps keys it does not know, so a newer client syncs through an older server. Keys are never removed or retyped.",
  "switch": {
    "title": "Sync settings",
    "summary": "Keep AnkiQuest settings the same on all your devices. This switch applies only to this device.",
    "default": true,
    "desktop": "sync_settings",
    "android": "ankiquestSyncSettings"
  },
  "keys": [
    {
      "key": "notify_rank",
      "type": "bool",
      "default": true,
      "desktop": "notify_rank",
      "android": "ankiquestNotifyRank"
    },
    {
      "key": "streak_warning_hours",
      "type": "int",
      "min": 0,
      "max": 12,
      "default": 2,
      "desktop": "streak_hours",
      "android": "ankiquestStreakReminderHours"
    },
    {
      "key": "session_summary",
      "type": "bool",
      "default": true,
      "desktop": "session_summary",
      "android": "ankiquestSessionSummary"
    },
    {
